{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS=--max-old-space-size=3072 next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-drgigi-repair --config firebase.test.json \"vitest run --config vitest.rules.config.mts\"",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "dataset:inventory": "tsx scripts/dataset-inventory.ts",
    "dataset:prepare": "tsx scripts/prepare-training.ts",
    "test:workflow": "firebase emulators:exec --only auth,firestore --project demo-sonri-workflow --config firebase.workflow-test.json \"playwright test --config playwright.workflow.config.ts\"",
    "coverage:export": "node --import tsx scripts/export-coverage.ts"
  },
  "dependencies": {
    "@google/genai": "^1.43.0",
    "@hookform/resolvers": "^5.2.1",
    "@vercel/oidc": "4.0.3",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "file-saver": "^2.0.5",
    "firebase": "^12.12.1",
    "firebase-admin": "^14.3.0",
    "google-auth-library": "11.3.0",
    "heic-decode": "^2.1.0",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^2.0.2",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.5.27",
    "pg": "^8.23.0",
    "postcss": "8.5.30",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^9.0.1",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/file-saver": "^2.0.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "9.39.1",
    "eslint-config-next": "^15.5.27",
    "firebase-tools": "^15.33.0",
    "tailwindcss": "4.1.11",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "packageManager": "npm@11.19.0",
  "overrides": {
    "@vercel/cli-config": {
      "zod": "$zod"
    },
    "@grpc/grpc-js": "1.14.6",
    "postcss": "$postcss",
    "postcss-selector-parser": "7.1.6",
    "basic-ftp": "6.2.3",
    "@opentelemetry/core": "2.8.0",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "gaxios": {
      "uuid": "11.1.1"
    }
  }
}
