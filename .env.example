# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AGNES_API_KEY: Optional failover AI provider (Agnes AI)
# Used automatically as a secondary backup when Gemini API is busy, rate-limited, or unavailable.
# Get free key at https://platform.agnes-ai.com
AGNES_API_KEY=
AGNES_BASE_URL="https://apihub.agnes-ai.com/v1"
AGNES_MODEL="agnes-2.5-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Admin: use managed Application Default Credentials / Workload Identity.
# Do not commit service-account JSON. GOOGLE_APPLICATION_CREDENTIALS may point to a
# secure local file for staging tests; production must use managed identity.
# GCLOUD_PROJECT must match the Firebase project used by the browser.
# FIRESTORE_DATABASE_ID defaults to the named database in firebase-applet-config.json.
# Never configure FIRESTORE_EMULATOR_HOST in production.

# SQL is legacy and is not used for new clinical writes in this repair.
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_SSL=true
# Separate migration credentials, only for approved operator-run SQL migration:
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# AI keys above are retained for compatibility, but clinical routes and adapters
# are deliberately disabled. Setting a key never enables unvalidated clinical use.
# SATUSEHAT submission is disabled; there is no client-side secret configuration.
# Re-enabling any remote integration requires a reviewed implementation and sandbox validation.
