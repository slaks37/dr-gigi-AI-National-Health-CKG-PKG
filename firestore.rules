rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.get('role', '') == 'admin'; }
    function doctor() { return signedIn() && request.auth.token.get('role', '') == 'doctor'; }
    function access(data) {
      return signedIn() && (data.userId == request.auth.uid || admin() ||
        (doctor() && data.get('assignedClinicianUids', []).hasAny([request.auth.uid])));
    }
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      // Roles are provisioned as Firebase custom claims by a trusted operator.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt', 'role'])
        && request.resource.data.uid == uid && request.resource.data.role == 'patient'
        && request.resource.data.email == request.auth.token.email;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']);
      allow delete: if false;
    }
    match /records/{id} {
      allow read: if access(resource.data);
      // All clinical mutations pass through the verified server transaction and audit trail.
      allow write: if false;
    }
    match /appointments/{id} {
      allow read: if access(resource.data);
      allow write: if false;
    }
    match /patients/{id} {
      allow read: if access(resource.data);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == id
        && request.resource.data.keys().hasOnly(['id', 'name', 'userId', 'dateOfBirth', 'gender', 'createdAt']);
      allow update: if access(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'dateOfBirth', 'gender']);
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || admin());
    }
    match /preferences/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /clinics/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /auditLogs/{id} { allow read: if admin(); allow write: if false; }
    match /clinicalReviews/{id} { allow read, write: if false; }
    match /datasetEntries/{id} { allow read, write: if false; }
    match /datasetAnnotations/{id} { allow read, write: if false; }
    match /datasetLabelReviews/{id} { allow read, write: if false; }
    match /screeningQuotas/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
